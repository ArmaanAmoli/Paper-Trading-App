WEB_PUSH_PUBLIC_KEY= your web push public key
WEB_PUSH_PRIVATE_KEY= your web push private key
VITE_WEB_PUSH_PUBLIC_KEY= same as web push public key
JWT_TOKEN_05_2036= JWT token generated for express websocket client to get price data from our python server
EXCHANGE_RATE_API= Get current exchange rates from -> https://www.exchangerate-api.com/
MONGO_URL = Create your mongodb url from mongo atlas -> https://www.mongodb.com/products/platform/atlas-database
JWT_SECRET = Keep your jwt secret here
FAST_API_SERVER_DOMAIN= http://localhost:8000 (your FastAPI server domain)
FAST_API_WEB_SOCKET_SERVER_DOMAIN= ws://localhost:8001 (your FastAPI WebSocket server domain)
EXPRESS_SERVER_PORT= 3001 (port for Express server)
VITE_API_BASE_URL= (leave empty in development: the frontend calls the API same-origin through the Vite proxy, which keeps auth cookies first-party; set to the API origin in production, e.g. http://localhost:3001)

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID= your_google_client_id
GOOGLE_CLIENT_SECRET= your_google_client_secret
GOOGLE_CALLBACK_URL= http://localhost:5173/api/auth/google/callback (frontend origin: the Vite proxy forwards /api/auth to Express, so Google-login cookies land on the same host as the app. The server swaps the host for the origin the login started from, so register BOTH http://localhost:5173/api/auth/google/callback and http://127.0.0.1:5173/api/auth/google/callback in Google Cloud Console — cookies are host-scoped and localhost/127.0.0.1 are different hosts)
FRONTEND_URL= http://localhost:5173
# Production frontend origin (added to the CORS/CSRF allowlist when NODE_ENV=production)
PRODUCTION_FRONTEND_URL= https://your-production-frontend.example.com
